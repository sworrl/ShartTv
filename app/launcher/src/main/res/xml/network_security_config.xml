<?xml version="1.0" encoding="utf-8"?>
<!--
  Shart TV network security.
  Destinations: Open-Meteo + Windy (weather/radar) over TLS, and your own BeaconFix on the LAN.
  Hardening kept: user-installed / MITM CAs are NOT trusted anywhere (system anchors only), so a
  rogue CA can't silently intercept. Cleartext is allowed only so the LAN BeaconFix (plain HTTP
  on the LAN by design) works.
  SSL PINNING NOTE: we do NOT pin the public weather APIs. They carry no secrets and no auth, and
  their Let's Encrypt certs rotate on a ~60-day cycle, which broke live weather when pinned. For a
  no-auth public endpoint, pinning buys almost no security while guaranteeing periodic outages.
  (If a future endpoint carries the owner's credentials, pin THAT one via a <domain-config>.)
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system"/>
    </trust-anchors>
  </base-config>
</network-security-config>
